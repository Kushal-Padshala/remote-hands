{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remote-hands-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remote-hands-db",
      "database_id": "6353f654-13f9-4908-b9ee-f18845d38813",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TASK_ROOM",
        "class_name": "TaskRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TaskRoom"]
    }
  ]
}
