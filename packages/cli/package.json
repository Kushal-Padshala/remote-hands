{
  "name": "remote-hands-cli",
  "version": "0.1.3",
  "description": "Phone-operated remote control plane for autonomous coding agents and browsers. Run tasks on your Mac or PC from your mobile phone with live screen streaming, human-in-the-loop approval gates, clamshell sleep prevention, and a 100% free Cloudflare serverless backend.",
  "keywords": [
    "remote-hands",
    "remote-hands-cli",
    "rh",
    "remote-terminal",
    "remote-control",
    "remote-access",
    "agentic-coding",
    "ai-agent",
    "ai-agents",
    "autonomous-agents",
    "browser-automation",
    "chrome-automation",
    "human-in-the-loop",
    "cloudflare",
    "cloudflare-workers",
    "cloudflare-d1",
    "durable-objects",
    "serverless",
    "tunnel",
    "ssh-alternative",
    "ngrok-alternative",
    "tailscale-alternative",
    "clamshell-mode",
    "mac-remote-access",
    "mobile-terminal",
    "zero-trust",
    "end-to-end-encryption",
    "cli",
    "terminal",
    "devtools"
  ],
  "homepage": "https://github.com/Kushal-Padshala/remote-hands#readme",
  "bugs": {
    "url": "https://github.com/Kushal-Padshala/remote-hands/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kushal-Padshala/remote-hands.git"
  },
  "author": "Kushal Padshala",
  "bin": {
    "remote-hands": "dist/index.js",
    "rh": "dist/index.js",
    "rh-browser": "dist/index.js"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:qrcode",
    "prepack": "rm -rf templates && mkdir -p templates/apps/cloudflare templates/apps/web && cp -R ../../apps/cloudflare/src ../../apps/cloudflare/migrations ../../apps/cloudflare/wrangler.jsonc templates/apps/cloudflare/ && cp -R ../../apps/web/dist ../../apps/web/wrangler.jsonc templates/apps/web/",
    "postpack": "rm -rf templates",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@remote-hands/control-plane": "0.0.0",
    "@remote-hands/daemon": "0.0.0",
    "@remote-hands/shared": "0.0.0",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.12",
    "vitest": "^5.0.1"
  }
}
